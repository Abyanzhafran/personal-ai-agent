{
  "name": "@cc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proses Node yang menjadi produk: REST + SSE, git, oasdiff, dan dua titik panggilan Claude.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --watch --conditions=source --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cc/shared": "*",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1"
  }
}
