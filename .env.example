# Salin ke .env (tidak di-commit) lalu isi ANTHROPIC_MODEL.
# Prioritas: variabel lingkungan proses > file ini.

# --- Wajib ---------------------------------------------------------------
# Nama model Claude yang dipakai discovery dan ekstraksi.
ANTHROPIC_MODEL=

# --- Opsional (nilai di bawah = default) ----------------------------------
# Server tetap start tanpa key; hanya panggilan Claude (discovery, ekstraksi) yang memintanya.
ANTHROPIC_API_KEY=
# Server selalu bind ke 127.0.0.1; host tidak bisa diubah lewat env.
PORT=4711
# Data aplikasi (app.db, contexts/, cache/, runs/). Harus absolut atau diawali ~.
WORKSPACE_DIR=~/.contract-check
# Batas file kandidat yang diekstraksi per check.
MAX_FILES_PER_CHECK=40
# Batas panggilan ekstraksi ke Claude per check (cache hit tidak dihitung); sisanya dilewati.
MAX_LLM_CALLS_PER_CHECK=40
GIT_CONCURRENCY=4
LLM_CONCURRENCY=4
SPEC_CMD_TIMEOUT_MS=180000
OASDIFF_BIN=oasdiff
